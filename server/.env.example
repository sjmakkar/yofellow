# Copy to .env only if you want to override defaults. Nothing is required for local dev.
PORT=4000

# Production only
# NODE_ENV=production
# JWT_SECRET=a-long-random-string-at-least-32-characters
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require   (Neon)

# Firebase login: Google + email/password (leave empty to use the dev email login locally)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=yourproject.firebaseapp.com
# FIREBASE_PROJECT_ID=yourproject
# FIREBASE_APP_ID=

# Pilot
# ADMIN_EMAILS=you@gmail.com       emails that get the /admin panel (comma separated)
# ADMIN_PHONES=9876543210          same for phone logins
# PHONE_LOGIN=1                    also offer SMS login (costs money per SMS, off by default)
# SUPPORT_EMAIL=you@example.com    shown in Privacy/Terms and used for web push

# Dev switches
# DEMO_BOTS=0      turn off demo travellers
# RADIO=0          do not start the dev Bluetooth stand-in
# PGLITE_DIR=...   where local Postgres keeps its data (default server/.pgdata)
